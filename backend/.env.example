# Server Configuration
PORT=3000

# Supabase (PostgreSQL with pgvector extension)
# Transaction pooler connection string (for Prisma client queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct session connection string (for Prisma migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"

# Supabase Storage & Service Key
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# JWT signing secrets — REQUIRED, the server refuses to start without them (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="generate-a-random-secret"
JWT_REFRESH_SECRET="generate-a-different-random-secret"

# Production settings
NODE_ENV="development"
# Browser origins allowed to call the API (comma-separated). The mobile app needs none.
# In production, origins not listed here are refused.
CORS_ORIGINS=""
# Number of reverse-proxy hops in front of the server (e.g. 1 on Render/Railway) so
# IP-based rate limits see the real client IP. Leave empty when not behind a proxy.
TRUST_PROXY=""

# Redis — REQUIRED in production (queue, shared rate limits, locks, cache).
# Empty = local dev mode: documents are processed inside the API, limits are per-process.
# With Redis set, also run the worker:  npm run worker  (or dev:worker)
REDIS_URL=""
WORKER_CONCURRENCY="2"

# Error tracking (optional). Student messages/document text are stripped from reports.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0"

# Logging: debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=""

# AI models (defaults: gemini-3.8-flash for both)
GEMINI_MODEL=""
GEMINI_FAST_MODEL=""
# Second-stage LLM reranking of search results (on unless "false"); measure with npm run eval:retrieval -- --rerank
RERANK_ENABLED="true"
# Real prices (USD per 1M tokens: input,output) so AiRequestLog.cost is accurate. One per model:
# AI_PRICE_GEMINI_3_8_FLASH="0.10,0.40"
AI_PRICE_DEFAULT=""
