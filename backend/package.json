{
  "name": "ai-study-backend",
  "version": "1.0.0",
  "description": "Backend for AI Study Companion",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push && ts-node --transpile-only scripts/post_db_push.ts",
    "test:isolation": "ts-node --transpile-only scripts/test_isolation.ts",
    "test:guardrails": "ts-node --transpile-only scripts/test_guardrails.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "worker": "node dist/worker.js",
    "eval:build": "ts-node --transpile-only scripts/eval/build_retrieval_set.ts",
    "eval:retrieval": "ts-node --transpile-only scripts/eval/run_retrieval_eval.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^0.0.52",
    "@prisma/client": "^5.19.1",
    "@sentry/node": "^8.55.2",
    "@supabase/supabase-js": "^2.116.0",
    "@types/pdf-parse": "^1.1.5",
    "ai": "^3.3.36",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "prisma": "^5.19.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
